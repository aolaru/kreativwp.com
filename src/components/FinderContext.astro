---
const { hosting = true } = Astro.props;
---
{hosting && <fieldset><legend>What does your host use?</legend><label><input type="radio" name="hosting" value="unknown" checked /> I’m not sure yet</label><label><input type="radio" name="hosting" value="litespeed" /> LiteSpeed or QUIC.cloud</label><label><input type="radio" name="hosting" value="managed" /> Hosting with its own page cache</label><label><input type="radio" name="hosting" value="other" /> Other hosting, without a page cache</label></fieldset>}
<fieldset><legend>Which budget applies?</legend><label><input type="radio" name="budget" value="free" checked /> Start with a free version</label><label><input type="radio" name="budget" value="premium" /> A paid workflow is acceptable</label></fieldset>
<details class="finder-existing"><summary>Already using plugins or host features?</summary><fieldset><legend>What is already covered?</legend>{[["cache", "Page cache"], ["security", "Security"], ["backups", "Backups"], ["forms", "Forms"], ["analytics", "Analytics"], ["email", "Email delivery"], ["seo", "SEO"], ["ecommerce", "Ecommerce"], ["maintenance", "Redirects"], ["images", "Image optimization"], ["translation", "Translation"], ["events", "Events"], ["content", "Tables"], ["development", "Developer diagnostics"], ["accessibility", "Accessibility assistance"], ["page-builder", "Page builder"]].map(([value, label]) => <label><input type="checkbox" name={`existing-${value}`} data-existing value={value} /> {label}</label>)}</fieldset></details>
