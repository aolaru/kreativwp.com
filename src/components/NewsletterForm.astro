---
const { id = "updates" } = Astro.props;
const subscribeUrl = import.meta.env.PUBLIC_NEWSLETTER_FORM_ACTION || "";
---
<form class="signup-form" id={`${id}-form`} action={subscribeUrl || undefined} method={subscribeUrl ? "post" : undefined} novalidate>
  <label class="sr-only" for={`${id}-email`}>Email address</label>
  <input class="signup-input" id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
  <button class="signup-button" type="submit">Request Updates</button>
</form>

<script is:inline define:vars={{ id, subscribeUrl }}>
  (() => {
    const form = document.getElementById(`${id}-form`);
    const emailInput = document.getElementById(`${id}-email`);
    if (!(form instanceof HTMLFormElement) || !(emailInput instanceof HTMLInputElement)) return;
    form.addEventListener("submit", (event) => {
      if (!emailInput.checkValidity()) {
        event.preventDefault();
        emailInput.reportValidity();
        return;
      }
      if (subscribeUrl) return;
      event.preventDefault();
      const email = encodeURIComponent(emailInput.value.trim());
      if (!email) return;
      window.location.href =
        "mailto:info@kreativwp.com?subject=Kreativ%20WP%20Updates%20Request&body=Please%20add%20this%20email%20to%20Kreativ%20WP%20updates%3A%20" + email;
    });
  })();
</script>
