---
const { id = "updates", label = "Request Updates" } = Astro.props;
const subscribeUrl = import.meta.env.PUBLIC_NEWSLETTER_FORM_ACTION || "";
if (subscribeUrl && new URL(subscribeUrl).protocol !== "https:") throw new Error("Newsletter endpoints must use HTTPS.");
---
<p id={`${id}-help`} class="signup-help">{subscribeUrl ? "Request product updates. Your email is sent to the subscription service." : "Ask me for product updates by email. This opens your email app; you still need to send the message."} <a href="/privacy/">Privacy</a></p>
<form class="signup-form" id={`${id}-form`} action={subscribeUrl || undefined} method={subscribeUrl ? "post" : undefined} novalidate>
  <label class="sr-only" for={`${id}-email`}>Email address</label>
  <input class="signup-input" id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby={`${id}-help`} required />
  <button class="signup-button" type="submit">{subscribeUrl ? label : "Open email request"}</button>
</form>
<p id={`${id}-status`} class="signup-help" role="status"></p>

<script is:inline define:vars={{ id, subscribeUrl }}>
  (() => {
    const form = document.getElementById(`${id}-form`);
    const emailInput = document.getElementById(`${id}-email`);
    if (!(form instanceof HTMLFormElement) || !(emailInput instanceof HTMLInputElement)) return;
    form.addEventListener("submit", (event) => {
      if (!emailInput.checkValidity()) {
        event.preventDefault();
        emailInput.reportValidity();
        return;
      }
      if (subscribeUrl) {
        window.dispatchEvent(new CustomEvent("kreativwp:track", { detail: { name: "updates_request", params: {} } }));
        return;
      }
      event.preventDefault();
      const email = encodeURIComponent(emailInput.value.trim());
      if (!email) return;
      const status = document.getElementById(`${id}-status`);
      if (status) status.textContent = "Send the prepared message in your email app to finish your request. If it did not open, email info@kreativwp.com directly.";
      window.dispatchEvent(new CustomEvent("kreativwp:track", { detail: { name: "updates_email_request", params: {} } }));
      window.location.href =
        "mailto:info@kreativwp.com?subject=Kreativ%20WP%20Updates%20Request&body=Please%20add%20this%20email%20to%20Kreativ%20WP%20updates%3A%20" + email;
    });
  })();
</script>
