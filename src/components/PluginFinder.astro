---
import FinderContext from "./FinderContext.astro";
import { getFinderCatalog } from "../data/finder-catalog";
import { pluginJobs } from "../data/recommendations";
const catalog = await getFinderCatalog();
---
<section class="plugin-finder" aria-labelledby="plugin-finder-title">
  <div><p class="eyebrow">Start with the job to be done</p><h2 id="plugin-finder-title">Find the right kind of WordPress plugin</h2><p class="section-intro">Choose an unmet requirement, then check a small research shortlist—not an automatic install list.</p></div>
  <form id="plugin-finder-form" class="stack-finder__form">
    <fieldset><legend>The job to be done</legend><label for="plugin-job">What job needs attention?</label><select id="plugin-job" name="job">{pluginJobs.map(([value, label]) => <option value={value}>{label}</option>)}</select></fieldset>
    <FinderContext />
    <button class="button-like button-like--primary" type="submit">Build my plugin shortlist</button>
  </form>
  <noscript><p>The interactive finder needs JavaScript. <a href="/plugins/">Browse all plugin profiles instead.</a></p></noscript>
  <div class="stack-finder__result" id="plugin-finder-result" aria-live="polite" hidden></div>
  <script type="application/json" id="plugin-finder-catalog" set:html={JSON.stringify(catalog).replace(/</g, "\\u003c")} />
</section>
<script>import { mountFinder } from "../scripts/finders"; mountFinder("plugin");</script>
