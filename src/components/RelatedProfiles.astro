---
type Props = { links: { label: string; href: string }[] };
const { links } = Astro.props;
---
{links.length > 0 && <section class="editorial-section related-profiles" aria-labelledby="related-profiles-title">
  <p class="section-label">Keep exploring</p>
  <h2 id="related-profiles-title">Related profiles</h2>
  <p>Compare the workflow, requirements, and limitations before choosing.</p>
  <ul>{links.map((link) => <li><a href={link.href}>{link.label} <span aria-hidden="true">→</span></a></li>)}</ul>
</section>}

<style>
  .related-profiles { border-top: 1px solid var(--card-border); padding-top: 1.5rem; }
  .related-profiles h2 { margin: .4rem 0; }
  .related-profiles p:not(.section-label) { color: var(--muted); }
  .related-profiles ul { display: flex; flex-wrap: wrap; gap: .6rem; list-style: none; margin-top: 1rem; }
  .related-profiles a { border: 1px solid var(--card-border); border-radius: 8px; display: inline-block; font-size: .9rem; font-weight: 700; padding: .65rem .85rem; }
</style>
