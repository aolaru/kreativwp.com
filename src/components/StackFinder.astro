---
import FinderContext from "./FinderContext.astro";
import { getFinderCatalog } from "../data/finder-catalog";
const catalog = await getFinderCatalog();
---
<section class="stack-finder" aria-labelledby="stack-finder-title">
  <div><p class="eyebrow">A smaller, saner starting point</p><h2 id="stack-finder-title">Build a minimal WordPress stack</h2><p class="section-intro">Start with the jobs your existing tools and host do not already cover.</p></div>
  <form id="stack-finder-form" class="stack-finder__form">
    <fieldset><legend>What are you building?</legend><label><input type="radio" name="site" value="content" checked /> Content, portfolio, or business site</label><label><input type="radio" name="site" value="store" /> An online store</label></fieldset>
    <fieldset><legend>How do you want to edit the site?</legend><label><input type="radio" name="editor" value="blocks" checked /> WordPress block editor</label><label><input type="radio" name="editor" value="visual" /> A visual page builder</label></fieldset>
    <FinderContext />
    <fieldset><legend>Which jobs need a new tool?</legend>{[["performance", "Page performance and caching"], ["security", "Security"], ["backups", "Backups"], ["forms", "Contact or lead-capture forms"], ["analytics", "Search and analytics reporting"], ["email", "Email delivery"], ["seo", "SEO"], ["images", "A large image library"], ["maintenance", "A URL migration or redirect cleanup"]].map(([value, label]) => <label><input type="checkbox" name={`needs-${value}`} data-need value={value} /> {label}</label>)}</fieldset>
    <button class="button-like button-like--primary" type="submit">Build my starting stack</button>
  </form>
  <noscript><p>The interactive finder needs JavaScript. <a href="/themes/">Browse themes</a> or <a href="/plugins/">browse plugins</a>.</p></noscript>
  <div class="stack-finder__result" id="stack-finder-result" aria-live="polite" hidden></div>
  <script type="application/json" id="stack-finder-catalog" set:html={JSON.stringify(catalog).replace(/</g, "\\u003c")} />
</section>
<script>import { mountFinder } from "../scripts/finders"; mountFinder("stack");</script>
