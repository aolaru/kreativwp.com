---
type Props = {
  href: string;
  name: string;
  developer: string;
  description: string;
  freeVersion: string;
  previewStyle: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  filterValues?: string[];
  isPlaceholder?: boolean;
  featured?: boolean;
  compact?: boolean;
  researchMethod?: "documented-research" | "hands-on";
  ctaLabel?: string;
  checkedDate?: string;
  checkedLabel?: string;
};

const { href, name, developer, description, freeVersion, previewStyle, thumbnail, thumbnailAlt, filterValues = [], isPlaceholder = false, featured = false, compact = false, researchMethod, ctaLabel = "View profile", checkedDate, checkedLabel = checkedDate } = Astro.props;
---
<article class:list={["theme-card", { "theme-card--featured": featured, "theme-card--compact": compact }]} data-library-card data-filters={filterValues.join(" ")}>
  <a class={`theme-thumbnail theme-thumbnail--${previewStyle}`} href={href} aria-label={`Read ${name} theme review`}>
    {thumbnail ? <><img data-card-image src={thumbnail} alt={thumbnailAlt || `${name} theme screenshot`} loading="lazy" /><span class="theme-thumbnail__fallback" aria-hidden="true"><span class="theme-thumbnail__browser"><i></i><i></i><i></i></span><span class="theme-thumbnail__nav"><b></b><em></em><em></em><em></em></span><span class="theme-thumbnail__hero"><strong></strong><small></small><small></small><mark></mark></span><span class="theme-thumbnail__tiles"><i></i><i></i><i></i></span></span></> : <><span class="theme-thumbnail__browser" aria-hidden="true"><i></i><i></i><i></i></span><span class="theme-thumbnail__nav" aria-hidden="true"><b></b><em></em><em></em><em></em></span><span class="theme-thumbnail__hero" aria-hidden="true"><strong></strong><small></small><small></small><mark></mark></span><span class="theme-thumbnail__tiles" aria-hidden="true"><i></i><i></i><i></i></span></>}
  </a>
  <div class="theme-card__body">
    <div class="theme-card__meta"><span>{developer}</span><span>{isPlaceholder ? "In research" : researchMethod === "hands-on" ? "Hands-on review" : "Documented profile"}</span></div>
    <h3><a href={href}>{name}</a></h3>
    <p>{description}</p>
    {checkedDate && <p class="profile-checked">Checked <time datetime={checkedDate}>{checkedLabel}</time></p>}
    <div class="theme-card__footer"><span>{freeVersion === "Available" ? "Free version available" : "Research in progress"}</span><a href={href}>{ctaLabel} <span aria-hidden="true">→</span></a></div>
  </div>
</article>
