---
import { getFinderCatalog } from "../data/finder-catalog";
const catalog = await getFinderCatalog();
---
<section class="theme-finder" aria-labelledby="theme-finder-title">
  <div><p class="eyebrow">A better first shortlist</p><h2 id="theme-finder-title">Find a WordPress theme that fits the work</h2><p class="section-intro">Match the editing workflow, site type, and budget. Every suggestion uses the same classifications as the theme library.</p></div>
  <form id="theme-finder-form" class="stack-finder__form">
    <fieldset><legend>What are you building?</legend><label><input type="radio" name="site" value="content" checked /> Content, portfolio, or business site</label><label><input type="radio" name="site" value="store" /> An online store</label></fieldset>
    <fieldset><legend>How do you want to edit?</legend><label><input type="radio" name="editor" value="blocks" checked /> WordPress block editor</label><label><input type="radio" name="editor" value="visual" /> A visual page builder</label></fieldset>
    <fieldset><legend>What matters most at the start?</legend><label><input type="radio" name="priority" value="lean" checked /> A lean, deliberate foundation</label><label><input type="radio" name="priority" value="design" /> More visual design control</label></fieldset>
    <fieldset><legend>Which constraint applies?</legend><label><input type="radio" name="budget" value="free" checked /> Start with a free version</label><label><input type="radio" name="budget" value="premium" /> A paid workflow is acceptable</label></fieldset>
    <button class="button-like button-like--primary" type="submit">Build my theme shortlist</button>
  </form>
  <noscript><p>The interactive finder needs JavaScript. <a href="/themes/">Browse all theme profiles instead.</a></p></noscript>
  <div class="stack-finder__result" id="theme-finder-result" aria-live="polite" hidden></div>
  <script type="application/json" id="theme-finder-catalog" set:html={JSON.stringify(catalog).replace(/</g, "\\u003c")} />
</section>
<script>import { mountFinder } from "../scripts/finders"; mountFinder("theme");</script>
