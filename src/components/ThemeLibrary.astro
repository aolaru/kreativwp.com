---
import { getCollection } from "astro:content";
import { editorialRank, librarySelections, shortBestFor, themeFilterGroups, themeFilters } from "../data/library";
import LibraryFilter from "./LibraryFilter.astro";
import ThemeCard from "./ThemeCard.astro";

const themes = (await getCollection("themeReviews")).sort((a, b) => a.data.themeName.localeCompare(b.data.themeName));
if (librarySelections.themes.some((id) => !themes.some((entry) => entry.id === id && !entry.data.isPlaceholder))) throw new Error("Theme editorial picks must refer to published profiles.");
---
<section class="theme-archive" data-library data-library-resource="themes" aria-labelledby="theme-reviews-title">
  <div class="section-heading"><div><p class="eyebrow">Editorial library</p><h2 id="theme-reviews-title">Explore WordPress themes</h2></div></div>
  <p class="section-intro">Find a theme by name, workflow, and fit. Editor’s picks are starting points—not a universal ranking.</p>
  <LibraryFilter id="theme-library" label="Filter WordPress themes" resource="themes" groups={themeFilterGroups} />
  <div class="theme-catalogue__grid" id="theme-library-grid" data-library-grid>
    {themes.map((theme) => <ThemeCard href={`/themes/${theme.id}/`} name={theme.data.themeName} developer={theme.data.developer} description={theme.data.description} bestFor={shortBestFor(theme.data.bestFor)} freeVersion={theme.data.freeVersion} previewStyle={theme.data.previewStyle} thumbnail={theme.data.thumbnail} thumbnailAlt={theme.data.thumbnailAlt} filterValues={themeFilters[theme.id] || []} isPlaceholder={theme.data.isPlaceholder} researchMethod={theme.data.researchMethod} libraryUpdated={theme.data.updated} editorialRank={editorialRank(theme.id, "themes")} />)}
  </div>
  <div class="library-more"><button class="button-like" type="button" data-library-more aria-controls="theme-library-grid" hidden>Show more themes</button></div>
  <p class="theme-catalogue__note">Screenshots come from WordPress.org. Profiles distinguish documentation research from hands-on tests.</p>
</section>
