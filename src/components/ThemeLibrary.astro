---
import { getCollection } from "astro:content";
import LibraryFilter from "./LibraryFilter.astro";
import ThemeCard from "./ThemeCard.astro";

const themes = (await getCollection("themeReviews")).sort((a, b) => a.data.themeName.localeCompare(b.data.themeName));
const themeFilters: Record<string, string[]> = {
  astra: ["lightweight", "block-editor", "page-builder", "business", "starter-sites", "free"], blocksy: ["lightweight", "block-editor", "ecommerce", "business", "starter-sites", "free"], divi: ["page-builder", "ecommerce", "business", "starter-sites"], frost: ["block-editor", "full-site-editing", "portfolio", "free"], generatepress: ["lightweight", "block-editor", "business", "free"], go: ["lightweight", "block-editor", "ecommerce", "business", "free"], "hello-elementor": ["lightweight", "page-builder", "free"], hestia: ["page-builder", "ecommerce", "business", "starter-sites", "free"], inspiro: ["portfolio", "page-builder", "starter-sites", "free"], jadro: ["lightweight", "block-editor", "full-site-editing", "business", "free"], kadence: ["block-editor", "ecommerce", "business", "starter-sites", "free"], neve: ["lightweight", "block-editor", "page-builder", "ecommerce", "business", "starter-sites", "free"], oceanwp: ["ecommerce", "page-builder", "business", "starter-sites", "free"], ollie: ["block-editor", "full-site-editing", "free"], raft: ["lightweight", "block-editor", "full-site-editing", "page-builder", "ecommerce", "free"], "spectra-one": ["block-editor", "full-site-editing", "portfolio", "free"], storefront: ["ecommerce", "free"], sydney: ["page-builder", "block-editor", "portfolio", "business", "starter-sites", "free"], "twenty-twenty-four": ["block-editor", "full-site-editing", "portfolio", "free"], "twenty-twenty-five": ["block-editor", "full-site-editing", "portfolio", "free"]
};
---
<section class="theme-archive" data-library data-filter-section aria-labelledby="theme-reviews-title">
  <div class="section-heading"><div><p class="eyebrow">Editorial library</p><h2 id="theme-reviews-title">Explore WordPress themes</h2></div></div>
  <p class="section-intro">Filter by the workflow and constraints that matter. Combine filters to narrow the catalog; every published profile distinguishes documented research from hands-on review.</p>
  <LibraryFilter label="Filter WordPress themes" filters={[{ label: "All themes", value: "all" }, { label: "Lightweight", value: "lightweight" }, { label: "Block editor", value: "block-editor" }, { label: "Page builder", value: "page-builder" }, { label: "Full site editing", value: "full-site-editing" }, { label: "Business", value: "business" }, { label: "Portfolio", value: "portfolio" }, { label: "WooCommerce", value: "ecommerce" }, { label: "Starter sites", value: "starter-sites" }, { label: "Free", value: "free" }]} />
  <div class="theme-catalogue__grid">{themes.map((theme, index) => <ThemeCard href={`/themes/${theme.id}/`} name={theme.data.themeName} developer={theme.data.developer} description={theme.data.description} freeVersion={theme.data.freeVersion} previewStyle={theme.data.previewStyle} thumbnail={theme.data.thumbnail} thumbnailAlt={theme.data.thumbnailAlt} filterValues={themeFilters[theme.id] || []} isPlaceholder={theme.data.isPlaceholder} featured={index === 0} />)}</div>
  <p class="theme-catalogue__note">Theme screenshots come from the relevant WordPress.org listings and link to research profiles, not vendor pages.</p>
</section>
