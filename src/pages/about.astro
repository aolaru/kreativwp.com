---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="About | Kreativ WP"
  description="About KreativWP, an independent WordPress resource and maker of practical WordPress tools."
  canonicalPath="/about/"
  ogTitle="About | Kreativ WP"
  ogDescription="Learn how KreativWP approaches independent WordPress research, practical guides, and useful tools."
  heroEyebrow="About"
  heroTitle="About KreativWP"
  heroTagline="Independent WordPress research, practical guidance, and focused tools for people building better sites."
  heroImageSrc="/kreativ-wp-logo-128.svg"
  heroImageAlt="Kreativ WP logo"
  currentPath="/about/"
>
  <section class="card plugin-details" aria-labelledby="mission-title">
    <h2 id="mission-title">Mission</h2>
    <article class="plugin-detail">
      <h3>Useful before persuasive</h3>
      <p>KreativWP is being built as a practical WordPress resource: useful research, clear guidance, and transparent product information before conversion pressure.</p>
    </article>
    <article class="plugin-detail">
      <h3>Independent, evidence-led work</h3>
      <p>Reviews and comparisons will show their scope, testing context, and trade-offs. We do not present editorial previews as completed first-hand testing.</p>
    </article>
    <article class="plugin-detail">
      <h3>We build tools too</h3>
      <p>Our own WordPress products stay clearly distinct from editorial coverage, while benefiting from the same maintenance-first approach.</p>
    </article>
  </section>

  <section class="launch-cta card" aria-labelledby="next-title">
    <h2 id="next-title">Next</h2>
    <p>Explore the editorial library, our products, or get in touch.</p>
    <p><a class="button-like" href="/guides/">Explore guides</a></p>
    <p><a class="detail-link" href="/products/">View products</a> · <a class="detail-link" href="/contact/">Contact</a></p>
  </section>
</BaseLayout>
