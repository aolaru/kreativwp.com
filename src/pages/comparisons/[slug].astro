---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialByline from "../../components/EditorialByline.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() { const entries = await getCollection("comparisons"); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
---
<BaseLayout title={`${entry.data.title} | KreativWP`} description={entry.data.metaDescription} canonicalPath={`/comparisons/${entry.id}/`} robots={entry.data.isPlaceholder ? "noindex,follow" : undefined} heroEyebrow="WordPress comparison" heroTitle={entry.data.title} heroTagline={entry.data.description} heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/comparisons/">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Comparisons", href: "/comparisons/" }, { label: entry.data.title }]} />
  <EditorialByline date={entry.data.updated} label={entry.data.updatedLabel} />
  {entry.data.isPlaceholder ? <div class="editorial-notice" role="status">Editorial preview — this comparison template does not make performance or product claims until hands-on testing is complete.</div> : <div class="editorial-notice" role="status">Published documentation research · last checked {entry.data.updatedLabel}. Benchmark, migration, and support conclusions require a stated hands-on test.</div>}
  <section class="editorial-section" aria-labelledby="compare-title"><h2 id="compare-title">{entry.data.leftName} and {entry.data.rightName}</h2><p class="section-intro">{entry.data.takeaway}</p><ul class="check-list">{entry.data.comparisonAreas.map((area) => <li>{area}</li>)}</ul></section>
  <section class="editorial-section" aria-labelledby="matrix-title"><h2 id="matrix-title">The practical differences</h2><p>Documentation checked {entry.data.updatedLabel}. Features depend on edition; vendor claims are not measured performance results.</p><section class="comparison-scroll" tabindex="0" aria-label="Side-by-side comparison, horizontally scrollable on small screens"><table class="comparison-table"><caption class="sr-only">{entry.data.title}: workflow and edition comparison</caption><thead><tr><th scope="col">Requirement</th><th scope="col"><a href={entry.data.leftHref}>{entry.data.leftName}</a></th><th scope="col"><a href={entry.data.rightHref}>{entry.data.rightName}</a></th></tr></thead><tbody>{entry.data.rows.map((row) => <tr><th scope="row">{row.label}<small class="comparison-row-sources">{row.sourceIds.map((id) => <a href={`#source-${id}`} aria-label={`${row.label} source ${id}`}>[{id}]</a>)}</small></th><td>{row.left}</td><td>{row.right}</td></tr>)}</tbody></table></section><h3>Before switching</h3><p>{entry.data.migration}</p></section>
  <section class="editorial-section source-links" aria-labelledby="comparison-sources-title"><h2 id="comparison-sources-title">Sources and evidence</h2><ul>{entry.data.sources.map((source) => <li id={`source-${source.id}`}><a href={source.href} target="_blank" rel="noopener noreferrer">[{source.id}] {source.label}</a></li>)}</ul></section>
  {entry.data.decisionGuide ? <section class="comparison-decision" aria-labelledby="decision-title"><p class="section-label">Decision guide</p><h2 id="decision-title">Choose for the workflow.</h2><div><article><h3>Choose {entry.data.leftName} if…</h3><p>{entry.data.decisionGuide.chooseLeft}</p></article><article><h3>Choose {entry.data.rightName} if…</h3><p>{entry.data.decisionGuide.chooseRight}</p></article></div><p class="editorial-caveat"><strong>Verify before deciding:</strong> {entry.data.decisionGuide.verify}</p><p class="centered-action"><a class="button-like" href="/methodology/">How we qualify comparisons</a></p></section> : null}
</BaseLayout>
