---
import { getCollection } from "astro:content";
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const comparisons = await getCollection("comparisons");
---
<BaseLayout title="WordPress Comparisons | KreativWP" description="Nuanced WordPress theme and plugin comparisons from KreativWP." canonicalPath="/comparisons/" heroEyebrow="WordPress research" heroTitle="Comparisons" heroTagline="Side-by-side WordPress comparisons that prioritize context over a universal winner." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/comparisons/">
  <section class="editorial-section" aria-labelledby="comparison-list-title"><div class="section-heading"><div><p class="eyebrow">Choose with context</p><h2 id="comparison-list-title">Theme &amp; plugin comparisons</h2></div></div><p class="section-intro">Published profiles identify the decision criteria and constraints that matter. Entries still in research remain clearly marked.</p><div class="content-grid content-grid--two">{comparisons.map((entry) => <ContentCard href={`/comparisons/${entry.id}/`} type="Comparison" title={entry.data.title} description={entry.data.description} updatedLabel={entry.data.updatedLabel} isPlaceholder={entry.data.isPlaceholder} />)}</div></section>
</BaseLayout>
