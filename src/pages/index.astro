---
import { getCollection } from "astro:content";
import PluginCard from "../components/PluginCard.astro";
import ThemeCard from "../components/ThemeCard.astro";
import { homepageFeatures } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const latestTheme = (await getCollection("themeReviews"))
  .find((entry) => entry.id === homepageFeatures.theme && !entry.data.isPlaceholder);
const latestPlugin = (await getCollection("pluginReviews"))
  .find((entry) => entry.id === homepageFeatures.plugin && !entry.data.isPlaceholder && entry.data.recommendationType !== "research");
if (!latestTheme || !latestPlugin) throw new Error("Homepage features must refer to published theme and plugin profiles.");
const liveProducts = (await getCollection("plugins"))
  .filter((entry) => entry.data.live)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "KreativWP", url: "https://kreativwp.com/" },
    { "@type": "WebSite", name: "KreativWP", url: "https://kreativwp.com/", potentialAction: { "@type": "SearchAction", target: "https://kreativwp.com/search/?q={search_term_string}", "query-input": "required name=search_term_string" } }
  ]
});
---
<BaseLayout title="KreativWP | WordPress Research and Tools" description="Independent WordPress research, practical theme and plugin guidance, and maintenance tools from KreativWP." canonicalPath="/" mainClass="homepage" heroEyebrow="Independent WordPress research" heroTitle="Choose WordPress with care." heroTagline="Thoughtful picks and practical tools for healthier, easier-to-manage sites." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/" structuredData={structuredData}>
  <section class="home-actions" aria-label="Explore KreativWP">
    <div class="button-row"><a class="button-like button-like--primary" href="/themes/">Find a theme</a><a class="button-like" href="/plugins/">Find a plugin</a><a class="button-like" href="/tools/">Use free tools</a></div>
  </section>

  <section class="product-edition" aria-labelledby="products-title">
    <div class="product-edition__intro"><p class="section-label">Built by KreativWP</p><h2 id="products-title">Little tools. Real relief.</h2><p>Keep the small problems from becoming site-wide problems.</p><a class="text-action" href="/products/">Explore all products <span aria-hidden="true">→</span></a></div>
    <div class="product-edition__list">
      {liveProducts.map((entry, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><img src={entry.data.thumb} width="68" height="68" alt={entry.data.imageAlt} loading="lazy" /><div><h3>{entry.data.name}</h3><p>{entry.data.description}</p><a href={`/plugins/${entry.id}/`}>Explore the tool <span aria-hidden="true">→</span></a></div></article>)}
    </div>
  </section>

  <section class="homepage-feature" aria-labelledby="latest-theme-title">
    <div class="homepage-feature__heading"><div><p class="section-label">Theme spotlight</p><h2 id="latest-theme-title">One thoughtful starting point.</h2></div><a class="text-action" href="/themes/">Explore all themes <span aria-hidden="true">→</span></a></div>
    <ThemeCard href={`/themes/${latestTheme.id}/`} name={latestTheme.data.themeName} developer={latestTheme.data.developer} description={latestTheme.data.description} freeVersion={latestTheme.data.freeVersion} previewStyle={latestTheme.data.previewStyle} thumbnail={latestTheme.data.thumbnail} thumbnailAlt={latestTheme.data.thumbnailAlt} isPlaceholder={latestTheme.data.isPlaceholder} researchMethod={latestTheme.data.researchMethod} />
  </section>

  <section class="homepage-feature homepage-feature--plugin" aria-labelledby="latest-plugin-title">
    <div class="homepage-feature__heading"><div><p class="section-label">Plugin spotlight</p><h2 id="latest-plugin-title">A useful tool, in context.</h2></div><a class="text-action" href="/plugins/">Explore all plugins <span aria-hidden="true">→</span></a></div>
    <PluginCard href={`/plugins/reviews/${latestPlugin.id}/`} name={latestPlugin.data.pluginName} developer={latestPlugin.data.developer} description={latestPlugin.data.description} freeVersion={latestPlugin.data.freeVersion} previewStyle={latestPlugin.data.previewStyle} imageSrc={latestPlugin.data.thumbnail} imageAlt={latestPlugin.data.thumbnailAlt} recommendationType={latestPlugin.data.recommendationType} isPlaceholder={latestPlugin.data.isPlaceholder} />
  </section>

  <section class="newsletter-panel" aria-labelledby="theme-checklist-title">
    <div><p class="section-label">Free decision checklist</p><h2 id="theme-checklist-title">Get the theme shortlist.</h2></div>
    <div><p>A short checklist for your next theme decision. Yours to keep—no email needed.</p><a class="button-like button-like--primary" href="/theme-checklist/">Open the checklist</a></div>
  </section>
</BaseLayout>
