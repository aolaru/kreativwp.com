---
import { getCollection } from "astro:content";
import PreviewImage from "../components/PreviewImage.astro";
import PluginCard from "../components/PluginCard.astro";
import ThemeCard from "../components/ThemeCard.astro";
import { homepageFeatures } from "../data/site";
import { librarySelections } from "../data/library";
import BaseLayout from "../layouts/BaseLayout.astro";

const themeCollection = await getCollection("themeReviews");
const pluginCollection = await getCollection("pluginReviews");
const themePicks = librarySelections.themes.slice(0, 3).map((id) => themeCollection.find((entry) => entry.id === id && !entry.data.isPlaceholder));
const pluginPicks = librarySelections.plugins.slice(0, 3).map((id) => pluginCollection.find((entry) => entry.id === id && !entry.data.isPlaceholder && entry.data.recommendationType !== "research"));
if (themePicks.some((entry) => !entry) || pluginPicks.some((entry) => !entry)) throw new Error("Homepage picks must refer to published profiles.");
const liveProducts = (await getCollection("plugins"))
  .filter((entry) => entry.data.live)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const featuredGuide = (await getCollection("guides"))
  .find((entry) => entry.id === homepageFeatures.guide && !entry.data.isPlaceholder);
if (!featuredGuide) throw new Error("The homepage guide must be a published guide.");
const shortDate = (date: string) => new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "KreativWP", url: "https://kreativwp.com/" },
    { "@type": "WebSite", name: "KreativWP", url: "https://kreativwp.com/", potentialAction: { "@type": "SearchAction", target: "https://kreativwp.com/search/?q={search_term_string}", "query-input": "required name=search_term_string" } }
  ]
});
---
<BaseLayout title="KreativWP | WordPress Research and Tools" description="Independent WordPress research, practical theme and plugin guidance, and maintenance tools from KreativWP." canonicalPath="/" mainClass="homepage" heroEyebrow="A small, independent WordPress resource" heroTitle="WordPress, with care." heroTagline="Hi, I’m Andrei. I build small WordPress tools and select resources to make everyday site work easier." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/" structuredData={structuredData}>
  <section class="home-actions" aria-label="Explore KreativWP">
    <div class="button-row"><a class="button-like button-like--primary" href="/themes/">Find a theme</a><a class="button-like" href="/plugins/">Find a plugin</a><a class="button-like" href="/tools/">Use free tools</a></div>
    <a class="text-action home-about" href="/about/">A little about me <span aria-hidden="true">→</span></a>
  </section>

  <section class="home-products" aria-labelledby="products-title">
    <div class="homepage-feature__heading"><div><p class="section-label">Made by me</p><h2 id="products-title">Little tools. Real relief.</h2></div><a class="text-action" href="/products/">Explore all products →</a></div>
    <article class="home-core">
      <div><p class="section-label">Our WordPress theme</p><h3>Kreativ Core</h3><p>A thoughtful home for your stories, ideas, and creative work.</p><a class="button-like button-like--primary" href="/products/kreativ-core/">Explore Kreativ Core</a><p class="home-core__status">Source available · WordPress.org submission</p></div>
      <figure><a href="/products/kreativ-core/" aria-label="Explore Kreativ Core"><img src="/kreativ-core-preview.png" alt="Kreativ Core theme artwork" width="1200" height="900" /></a><figcaption>Theme artwork</figcaption></figure>
    </article>
    <div class="home-product-grid">
      {liveProducts.map((entry) => <article class="home-product">
        <a href={`/plugins/${entry.id}/`} aria-label={`See ${entry.data.name} in action`}>{entry.data.homepageScreenshot ? <PreviewImage src={entry.data.homepageScreenshot.src} alt={entry.data.homepageScreenshot.alt} width={entry.data.homepageScreenshot.width} height={entry.data.homepageScreenshot.height} sizes="(max-width: 650px) calc(100vw - 40px), 450px" /> : entry.data.screenshots?.[0] ? <PreviewImage src={entry.data.screenshots[0].src} alt={entry.data.screenshots[0].alt} width={entry.data.screenshots[0].width} height={entry.data.screenshots[0].height} /> : <img src={entry.data.thumb} alt={entry.data.imageAlt} width="128" height="128" />}<span class="home-product__fallback" aria-hidden="true"><img src={entry.data.thumb} alt="" width="128" height="128" /></span></a>
        <div class="home-product__body"><p class="section-label">Free WordPress plugin</p><h3>{entry.data.name}</h3><p>{entry.data.description}</p><div class="product-edition__actions">{entry.data.downloadHref && <a class="button-like button-like--primary" href={entry.data.downloadHref} data-track="product_download" data-product={entry.id} aria-label={`Download free: ${entry.data.name}`}>Download free</a>}<a class="text-action" href={`/plugins/${entry.id}/`}>View product →</a></div></div>
      </article>)}
    </div>
  </section>

  <section class="homepage-feature" aria-labelledby="latest-theme-title">
    <div class="homepage-feature__heading"><div><p class="section-label">A few starting points</p><h2 id="latest-theme-title">Theme picks</h2></div><a class="text-action" href="/themes/">Explore all themes <span aria-hidden="true">→</span></a></div>
    <div class="home-pick-grid">{themePicks.map((item) => item && <ThemeCard href={`/themes/${item.id}/`} name={item.data.themeName} developer={item.data.developer} description={item.data.homepageSummary || item.data.bestFor} freeVersion={item.data.freeVersion} previewStyle={item.data.previewStyle} thumbnail={item.data.thumbnail} thumbnailAlt={item.data.thumbnailAlt} researchMethod={item.data.researchMethod} ctaLabel="View theme" checkedDate={item.data.updated} checkedLabel={shortDate(item.data.updated)} />)}</div>
  </section>

  <section class="homepage-feature homepage-feature--plugin" aria-labelledby="latest-plugin-title">
    <div class="homepage-feature__heading"><div><p class="section-label">Useful for specific jobs</p><h2 id="latest-plugin-title">Plugin picks</h2></div><a class="text-action" href="/plugins/">Explore all plugins <span aria-hidden="true">→</span></a></div>
    <div class="home-pick-grid">{pluginPicks.map((item) => item && <PluginCard href={`/plugins/reviews/${item.id}/`} name={item.data.pluginName} developer={item.data.developer} description={item.data.homepageSummary || item.data.bestFor} freeVersion={item.data.freeVersion} previewStyle={item.data.previewStyle} imageSrc={item.data.thumbnail} imageAlt={item.data.thumbnailAlt} recommendationType={item.data.recommendationType} ctaLabel="View plugin" checkedDate={item.data.updated} checkedLabel={shortDate(item.data.updated)} />)}</div>
  </section>

  <aside class="home-guide" aria-labelledby="home-guide-title"><p id="home-guide-title">Not sure where to start?</p><a href={`/guides/${featuredGuide.id}/`}>{featuredGuide.data.title} <span aria-hidden="true">→</span></a></aside>

  <section class="newsletter-panel" aria-labelledby="theme-checklist-title">
    <div><p class="section-label">Free decision checklist</p><h2 id="theme-checklist-title">Get the theme shortlist.</h2></div>
    <div><p>A short checklist for your next theme decision. Yours to keep—no email needed.</p><a class="button-like button-like--primary" href="/theme-checklist/" data-track="checklist_open" data-resource="theme-checklist">Open the checklist</a></div>
  </section>
</BaseLayout>
