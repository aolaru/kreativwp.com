---
import ThemeLibrary from "../components/ThemeLibrary.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "KreativWP", url: "https://kreativwp.com/" },
    { "@type": "WebSite", name: "KreativWP", url: "https://kreativwp.com/", potentialAction: { "@type": "SearchAction", target: "https://kreativwp.com/search/?q={search_term_string}", "query-input": "required name=search_term_string" } }
  ]
});
---
<BaseLayout title="WordPress Themes | KreativWP" description="Browse independent, clearly scoped WordPress theme reviews and selection guidance from KreativWP." canonicalPath="/" heroEyebrow="WordPress theme library" heroTitle="Find a WordPress theme that fits the work." heroTagline="Explore 20 documented theme profiles by editing workflow, ecommerce needs, portfolio fit, and free availability." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/" structuredData={structuredData}>
  <ThemeLibrary />
</BaseLayout>
