---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const pluginEntries = (await getCollection("plugins")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
);
const livePlugins = pluginEntries.filter((plugin) => plugin.data.live);
const upcomingPlugins = pluginEntries.filter((plugin) => !plugin.data.live);
const nextRelease = upcomingPlugins[0];
const latestLivePlugin = livePlugins[livePlugins.length - 1];

const structuredData = JSON.stringify(
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        name: "Kreativ WP",
        url: "https://kreativwp.com/"
      },
      {
        "@type": "ItemList",
        name: "Kreativ WP Plugins",
        itemListElement: pluginEntries.map((plugin, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "SoftwareApplication",
            name: plugin.data.name,
            applicationCategory: "DeveloperApplication",
            operatingSystem: "WordPress",
            url: new URL(`/plugins/${plugin.id}/`, Astro.site).toString()
          }
        }))
      }
    ]
  },
  null,
  2
);
---
<BaseLayout
  title="Kreativ WP"
  description="Practical WordPress utilities and maintenance plugins built for real sites."
  canonicalPath="/"
  heroEyebrow="WordPress utilities"
  heroTitle="Kreativ WP"
  heroTagline="Practical WordPress utilities and maintenance plugins built for reliability, not hype."
  heroImageSrc="/kreativ-wp-logo-128.svg"
  heroImageAlt="Kreativ WP logo"
  currentPath="/"
  structuredData={structuredData}
>
  <section class="plugins card" aria-labelledby="plugins-title">
    <h2 id="plugins-title">Live Plugins</h2>
    <p class="plugins-intro">Two utilities are already live on WordPress.org and built for practical maintenance work.</p>
    <ul class="product-grid">
      {livePlugins.map((plugin) => (
        <li>
          <article class="product-card" id={plugin.id}>
            <img class="product-thumb" src={plugin.data.thumb} width="128" height="128" alt={plugin.data.imageAlt} />
            <h3 class="product-title">{plugin.data.name}</h3>
            <p class="product-meta">{plugin.data.cardMeta}</p>
            <p class="product-use">{plugin.data.cardUse}</p>
            <span class="coming">Live now · Ready on WordPress.org</span>
            <a class="cta" href={plugin.data.ctaHref} target="_blank" rel="noopener noreferrer">{plugin.data.ctaLabel}</a>
            {plugin.data.supportingLinks?.[0] ? (
              <a class="detail-link" href={plugin.data.supportingLinks[0].href}>{plugin.data.supportingLinks[0].label}</a>
            ) : null}
            <a class="detail-link" href={`/plugins/${plugin.id}/`}>Plugin details</a>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <section class="card plugin-details" aria-labelledby="next-release-title">
    <h2 id="next-release-title">Next Release</h2>
    <article class="plugin-detail">
      <h3>{nextRelease.data.name}</h3>
      <p>{nextRelease.data.cardUse}</p>
      <p><strong>Status:</strong> {nextRelease.data.homepageStatus}</p>
      <p><a class="button-like" href={`/plugins/${nextRelease.id}/`}>Review next plugin</a></p>
    </article>
    {upcomingPlugins.slice(1).map((plugin) => (
      <article class="plugin-detail">
        <h3>{plugin.data.name}</h3>
        <p>{plugin.data.cardUse}</p>
        <p>{plugin.data.homepageStatus}</p>
      </article>
    ))}
  </section>

  <section class="card plugin-details" aria-labelledby="process-title">
    <h2 id="process-title">Submission Process</h2>
    <article class="plugin-detail">
      <h3>How we prepare releases</h3>
      <p>Before a plugin goes public, we review packaging, admin-side hygiene, security basics, and uninstall behavior to reduce avoidable WordPress.org review friction.</p>
      <p><a class="detail-link" href="/news/wordpress-org-submission-checklist/">Read the submission checklist</a></p>
    </article>
  </section>

  <section class="card plugin-details" aria-labelledby="timeline-title">
    <h2 id="timeline-title">Release Timeline</h2>
    <article class="plugin-detail">
      <h3>Latest live plugin</h3>
      <p>{latestLivePlugin.data.name} is live on WordPress.org and reflects the current maintenance-first direction of Kreativ WP.</p>
    </article>
    <article class="plugin-detail">
      <h3>Current focus</h3>
      <p>Submission prep is active now, with packaging, admin-side hygiene, and release scoping driving the current work.</p>
    </article>
    <article class="plugin-detail">
      <h3>Next planned release</h3>
      <p>{nextRelease.data.name} remains the next release target, with {upcomingPlugins[1].data.name} staying behind it in the near-term queue.</p>
    </article>
  </section>

  <section class="launch-cta card" aria-labelledby="updates-title">
    <h2 id="updates-title">Get Product Updates</h2>
    <p>Receive release notes and launch announcements by email.</p>
    <form class="signup-form" id="updates-form" novalidate>
      <label class="sr-only" for="updates-email">Email address</label>
      <input class="signup-input" id="updates-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      <button class="signup-button" type="submit">Request Updates</button>
    </form>
  </section>

  <script slot="scripts" is:inline>
    (() => {
      const updatesForm = document.getElementById("updates-form");
      const updatesEmail = document.getElementById("updates-email");
      if (!updatesForm || !updatesEmail) return;
      updatesForm.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!updatesEmail.checkValidity()) {
          updatesEmail.reportValidity();
          return;
        }
        const email = encodeURIComponent(updatesEmail.value.trim());
        if (!email) return;
        window.location.href =
          "mailto:info@kreativwp.com?subject=Kreativ%20WP%20Updates%20Request&body=Please%20add%20this%20email%20to%20Kreativ%20WP%20updates%3A%20" +
          email;
      });
    })();
  </script>
</BaseLayout>
