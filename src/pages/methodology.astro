---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Editorial Methodology | KreativWP" description="How KreativWP qualifies WordPress research, reviews, comparisons, and affiliate relationships." canonicalPath="/methodology/" heroEyebrow="Independent WordPress research" heroTitle="Our Methodology" heroTagline="Useful product research should show its scope, evidence, and trade-offs." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo">
  <section class="editorial-section" aria-labelledby="method-title">
    <h2 id="method-title">How we work</h2>
    <p class="section-intro">We publish practical WordPress guidance and build products of our own. Those activities are kept distinct: editorial pages disclose commercial relationships and do not call a product tested until the test context is documented.</p>
    <p class="centered-action"><a class="button-like button-like--primary" href="/guides/testing-methodology/">Read the testing methodology</a></p>
  </section>
  <section class="editorial-section" aria-labelledby="standards-title">
    <h2 id="standards-title">Editorial standards</h2>
    <ul class="check-list"><li>Documented test environment and versions for completed hands-on reviews.</li><li>Clear separation between documented facts, observations, and recommendations.</li><li>Use-case-specific conclusions rather than universal winners.</li><li>Affiliate disclosure wherever an approved affiliate destination is present.</li></ul>
  </section>
</BaseLayout>
