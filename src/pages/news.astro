---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
const newsPosts = (await getCollection("news")).sort((a, b) =>
  b.data.published.localeCompare(a.data.published)
);
const featuredPost = newsPosts.find((post) => post.data.featured) ?? newsPosts[0];
const remainingPosts = newsPosts.filter((post) => post.id !== featuredPost.id);
const releasePosts = remainingPosts.filter((post) => post.data.kind === "release");
const processPosts = remainingPosts.filter((post) => post.data.kind === "process");
const statusPosts = remainingPosts.filter((post) => post.data.kind === "status");
const websitePosts = remainingPosts.filter((post) => post.data.kind === "website");
const livePlugins = (await getCollection("plugins"))
  .filter((plugin) => plugin.data.live)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const nextRelease = (await getCollection("plugins"))
  .filter((plugin) => !plugin.data.live)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)[0];
---
<BaseLayout
  title="News | Kreativ WP"
  description="Latest Kreativ WP plugin updates, release notes, and roadmap highlights."
  canonicalPath="/news/"
  ogTitle="News | Kreativ WP"
  ogDescription="Latest Kreativ WP plugin updates, release notes, and roadmap highlights."
  heroEyebrow="News"
  heroTitle="Latest Updates"
  heroTagline="Release notes, product updates, and roadmap highlights for Kreativ WP plugins."
  heroImageSrc="/kreativ-wp-logo-128.svg"
  heroImageAlt="Kreativ WP logo"
  currentPath="/news/"
>
  <section class="card plugin-details" aria-labelledby="featured-news-title">
    <h2 id="featured-news-title">Featured Update</h2>
    <article class="plugin-detail">
      <p class="news-meta">{featuredPost.data.publishedLabel} · {featuredPost.data.tag}</p>
      <h3><a href={`/news/${featuredPost.id}/`}>{featuredPost.data.title}</a></h3>
      <p>{featuredPost.data.intro}</p>
      {featuredPost.data.ctaHref && featuredPost.data.ctaLabel ? (
        <p><a class="button-like" href={featuredPost.data.ctaHref}>{featuredPost.data.ctaLabel}</a></p>
      ) : null}
    </article>
  </section>

  <section class="card plugin-details" aria-labelledby="release-notes-title">
    <h2 id="release-notes-title">Release Notes</h2>
    <ul class="news-list">
      {releasePosts.map((post) => (
        <li class="news-item">
          <p class="news-meta">{post.data.publishedLabel} · {post.data.tag}</p>
          <h3><a href={`/news/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.intro}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="card plugin-details" aria-labelledby="process-updates-title">
    <h2 id="process-updates-title">Process and Status Updates</h2>
    <ul class="news-list">
      {[...processPosts, ...statusPosts, ...websitePosts].map((post) => (
        <li class="news-item">
          <p class="news-meta">{post.data.publishedLabel} · {post.data.tag}</p>
          <h3><a href={`/news/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.intro}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="card plugin-details" aria-labelledby="plugin-links-title">
    <h2 id="plugin-links-title">Plugin Links</h2>
    {livePlugins.map((plugin) => (
      <article class="plugin-detail">
        <h3>{plugin.data.name}</h3>
        <p><a class="cta" href={plugin.data.ctaHref} target="_blank" rel="noopener noreferrer">{plugin.data.ctaLabel}</a></p>
        {plugin.data.supportingLinks?.map((link) => (
          <p><a class="detail-link" href={link.href}>{link.label}</a></p>
        ))}
      </article>
    ))}
  </section>

  <section class="launch-cta card" aria-labelledby="roadmap-title">
    <h2 id="roadmap-title">Roadmap</h2>
    <p>Current focus is getting back into WordPress plugin submission flow, with {nextRelease.data.name} still positioned as the next release target.</p>
  </section>

  <section class="launch-cta card" aria-labelledby="updates-title">
    <h2 id="updates-title">Get Product Updates</h2>
    <NewsletterForm id="updates" />
  </section>

</BaseLayout>
