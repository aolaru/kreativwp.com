---
import { getCollection } from "astro:content";
import LibraryFilter from "../../components/LibraryFilter.astro";
import PluginCard from "../../components/PluginCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const reviews = (await getCollection("pluginReviews")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const coreReviews = reviews.filter((entry) => entry.data.recommendationType === "core");
const conditionalReviews = reviews.filter((entry) => entry.data.recommendationType === "conditional");
const researchReviews = reviews.filter((entry) => entry.data.recommendationType === "research");
const products = (await getCollection("plugins")).filter((entry) => entry.data.live).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const pluginFilters: Record<string, string[]> = { "wp-rocket": ["performance", "core"], "litespeed-cache": ["performance", "conditional"], updraftplus: ["backups", "core"], wordfence: ["security", "core"], "fluent-forms": ["forms", "core"], "site-kit": ["analytics", "core"], "wp-mail-smtp": ["email", "core"], "rank-math": ["seo", "core"], woocommerce: ["ecommerce", "conditional"], redirection: ["maintenance", "conditional"], shortpixel: ["images", "conditional"], "performance-plugins": ["research"], "designer-plugins": ["research"] };
---
<BaseLayout title="WordPress Plugin Reviews | KreativWP" description="Task-first WordPress plugin research, practical maintenance tools, and products built by KreativWP." canonicalPath="/plugins/" heroEyebrow="WordPress research" heroTitle="Plugins" heroTagline="A practical WordPress stack: core picks for most sites, plus focused tools for specific requirements." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/plugins/">
  <div data-library>
    <LibraryFilter label="Filter WordPress plugins" filters={[{ label: "All plugins", value: "all" }, { label: "Core stack", value: "core" }, { label: "Performance", value: "performance" }, { label: "Security", value: "security" }, { label: "Forms", value: "forms" }, { label: "Analytics", value: "analytics" }, { label: "SEO", value: "seo" }, { label: "Maintenance", value: "maintenance" }]} />
    <section class="plugin-archive" data-filter-section aria-labelledby="review-title"><div class="section-heading"><div><p class="eyebrow">Start with the essentials</p><h2 id="review-title">Core plugin picks</h2></div></div><p class="section-intro">These solve recurring operational needs. Add only what your site actually needs, and avoid overlapping plugins—especially SEO and page-cache tools.</p><div class="plugin-catalogue__grid">{coreReviews.map((entry, index) => <PluginCard href={`/plugins/reviews/${entry.id}/`} name={entry.data.pluginName} developer={entry.data.developer} description={entry.data.description} freeVersion={entry.data.freeVersion} previewStyle={entry.data.previewStyle} imageSrc={entry.data.thumbnail} imageAlt={entry.data.thumbnailAlt} filterValues={pluginFilters[entry.id] || []} recommendationType={entry.data.recommendationType} isPlaceholder={entry.data.isPlaceholder} featured={index === 0} />)}</div></section>
    <section class="plugin-archive" data-filter-section aria-labelledby="conditional-title"><div class="section-heading"><div><p class="eyebrow">Choose only when needed</p><h2 id="conditional-title">Specialized stack additions</h2></div></div><p class="section-intro">These are strong tools for the right requirement—not default installs. Each profile explains the constraint before the recommendation.</p><div class="plugin-catalogue__grid">{conditionalReviews.map((entry) => <PluginCard href={`/plugins/reviews/${entry.id}/`} name={entry.data.pluginName} developer={entry.data.developer} description={entry.data.description} freeVersion={entry.data.freeVersion} previewStyle={entry.data.previewStyle} imageSrc={entry.data.thumbnail} imageAlt={entry.data.thumbnailAlt} filterValues={pluginFilters[entry.id] || []} recommendationType={entry.data.recommendationType} isPlaceholder={entry.data.isPlaceholder} />)}</div><p class="theme-catalogue__note">Screenshots are supplied by official WordPress.org plugin listings, except where the vendor hosts the product image directly.</p></section>
    <section class="plugin-archive" data-filter-section aria-labelledby="product-title"><div class="section-heading"><div><p class="eyebrow">Built by KreativWP</p><h2 id="product-title">Maintenance tools we make</h2></div><a class="detail-link" href="/products/">All products</a></div><div class="plugin-catalogue__grid">{products.map((entry) => <PluginCard href={`/plugins/${entry.id}/`} name={entry.data.name} developer="KreativWP" description={entry.data.description} freeVersion="Free on WordPress.org" previewStyle="product" imageSrc={entry.data.thumb} imageAlt={entry.data.imageAlt} filterValues={["maintenance", "product"]} recommendationType="product" />)}</div></section>
    <section class="plugin-archive" data-filter-section aria-labelledby="research-title"><div class="section-heading"><div><p class="eyebrow">Still in research</p><h2 id="research-title">Future recommendation briefs</h2></div></div><div class="plugin-catalogue__grid">{researchReviews.map((entry) => <PluginCard href={`/plugins/reviews/${entry.id}/`} name={entry.data.pluginName} developer={entry.data.developer} description={entry.data.description} freeVersion={entry.data.freeVersion} previewStyle={entry.data.previewStyle} filterValues={pluginFilters[entry.id] || []} recommendationType={entry.data.recommendationType} isPlaceholder={entry.data.isPlaceholder} />)}</div></section>
  </div>
</BaseLayout>
