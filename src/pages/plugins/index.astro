---
import { getCollection } from "astro:content";
import PluginCard from "../../components/PluginCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const reviews = (await getCollection("pluginReviews")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const products = (await getCollection("plugins")).filter((entry) => entry.data.live).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---
<BaseLayout title="WordPress Plugin Reviews | KreativWP" description="WordPress plugin research, practical maintenance tools, and products built by KreativWP." canonicalPath="/plugins/" heroEyebrow="WordPress research" heroTitle="Plugins" heroTagline="A visual library of editorial plugin research, practical utilities, and products made by KreativWP." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/plugins/">
  <section class="plugin-archive" aria-labelledby="review-title"><div class="section-heading"><div><p class="eyebrow">Browse by practical need</p><h2 id="review-title">Explore WordPress plugins</h2></div></div><p class="section-intro">Every card makes its scope clear: editorial collections are marked as research until testing is complete; KreativWP product cards link to their published listings.</p><div class="theme-catalogue__filters"><span>All plugins</span><span>Performance</span><span>Design workflow</span><span>Site maintenance</span><span>Free</span></div><div class="plugin-catalogue__grid">{reviews.map((entry, index) => <PluginCard href={`/plugins/reviews/${entry.id}/`} name={entry.data.pluginName} developer={entry.data.developer} description={entry.data.description} freeVersion={entry.data.freeVersion} previewStyle={entry.data.previewStyle} isPlaceholder={entry.data.isPlaceholder} featured={index === 0} />)}{products.map((entry) => <PluginCard href={`/plugins/${entry.id}/`} name={entry.data.name} developer="KreativWP" description={entry.data.description} freeVersion="Free on WordPress.org" previewStyle="product" imageSrc={entry.data.thumb} imageAlt={entry.data.imageAlt} />)}</div></section>
</BaseLayout>
