---
import { getCollection } from "astro:content";
import AffiliateDisclosure from "../../../components/AffiliateDisclosure.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getAffiliateLink } from "../../../data/affiliate";
import BaseLayout from "../../../layouts/BaseLayout.astro";
export async function getStaticPaths() { const entries = await getCollection("pluginReviews"); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const affiliate = getAffiliateLink(entry.data.affiliateId);
---
<BaseLayout title={`${entry.data.title} | KreativWP`} description={entry.data.metaDescription} canonicalPath={`/plugins/reviews/${entry.id}/`} robots={entry.data.isPlaceholder ? "noindex,follow" : undefined} heroEyebrow="Plugin recommendation" heroTitle={entry.data.title} heroTagline={entry.data.description} heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/plugins/">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Plugins", href: "/plugins/" }, { label: entry.data.title }]} />
  {entry.data.isPlaceholder ? <div class="editorial-notice" role="status">Editorial preview — this is a planned, evidence-led recommendation structure, not a completed tested review.</div> : null}
  <section class="editorial-section" aria-labelledby="framework-title"><h2 id="framework-title">Editorial framework</h2><dl class="fact-grid"><div><dt>Developer</dt><dd>{entry.data.developer}</dd></div><div><dt>Free version</dt><dd>{entry.data.freeVersion}</dd></div><div><dt>Pricing</dt><dd>{entry.data.pricing}</dd></div><div><dt>Best for</dt><dd>{entry.data.bestFor}</dd></div></dl></section>
  <section class="editorial-section" aria-labelledby="focus-title"><h2 id="focus-title">What we’ll assess</h2><ul class="check-list">{entry.data.highlights.map((item) => <li>{item}</li>)}</ul></section>
  {affiliate ? <><AffiliateDisclosure /><p class="centered-action"><a class="button-like" href={affiliate.href} target="_blank" rel="sponsored noopener noreferrer">{affiliate.label}</a></p></> : null}
</BaseLayout>
