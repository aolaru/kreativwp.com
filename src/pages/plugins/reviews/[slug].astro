---
import { getCollection } from "astro:content";
import AffiliateDisclosure from "../../../components/AffiliateDisclosure.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getAffiliateLink } from "../../../data/affiliate";
import BaseLayout from "../../../layouts/BaseLayout.astro";
export async function getStaticPaths() { const entries = await getCollection("pluginReviews"); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const affiliate = getAffiliateLink(entry.data.affiliateId);
---
<BaseLayout title={`${entry.data.title} | KreativWP`} description={entry.data.metaDescription} canonicalPath={`/plugins/reviews/${entry.id}/`} robots={entry.data.isPlaceholder ? "noindex,follow" : undefined} heroEyebrow="Plugin recommendation" heroTitle={entry.data.title} heroTagline={entry.data.description} heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/plugins/">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Plugins", href: "/plugins/" }, { label: entry.data.title }]} />
  {entry.data.isPlaceholder ? <div class="editorial-notice" role="status">Editorial preview — this is a planned, evidence-led recommendation structure, not a completed tested review.</div> : <div class="editorial-notice" role="status">Published documentation research — scope and source links are shown below.</div>}
  <section class="editorial-section" aria-labelledby="framework-title"><h2 id="framework-title">Profile at a glance</h2><dl class="fact-grid"><div><dt>Developer</dt><dd>{entry.data.developer}</dd></div><div><dt>Free version</dt><dd>{entry.data.freeVersion}</dd></div><div><dt>Pricing</dt><dd>{entry.data.pricing}</dd></div><div><dt>Best for</dt><dd>{entry.data.bestFor}</dd></div></dl></section>
  <section class="editorial-section" aria-labelledby="focus-title"><h2 id="focus-title">What the documentation confirms</h2><ul class="check-list">{entry.data.highlights.map((item) => <li>{item}</li>)}</ul></section>
  {entry.data.researchScope ? <section class="editorial-section" aria-labelledby="scope-title"><h2 id="scope-title">Research scope</h2><p class="section-intro">{entry.data.researchScope}</p>{entry.data.caveats ? <p class="editorial-caveat"><strong>Important:</strong> {entry.data.caveats}</p> : null}{entry.data.sources ? <div class="source-links"><strong>Sources</strong><ul>{entry.data.sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul></div> : null}{entry.data.officialUrl ? <p class="centered-action"><a class="button-like" href={entry.data.officialUrl} target="_blank" rel="noopener noreferrer">Visit the official site</a></p> : null}</section> : null}
  {affiliate ? <><AffiliateDisclosure /><p class="centered-action"><a class="button-like" href={affiliate.href} target="_blank" rel="sponsored noopener noreferrer">{affiliate.label}</a></p></> : null}
</BaseLayout>
