---
import { getCollection } from "astro:content";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialByline from "../../components/EditorialByline.astro";
import { getAffiliateLink } from "../../data/affiliate";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() { const entries = await getCollection("themeReviews"); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const affiliate = getAffiliateLink(entry.data.affiliateId);
---
<BaseLayout title={`${entry.data.title} | KreativWP`} description={entry.data.metaDescription} canonicalPath={`/themes/${entry.id}/`} robots={entry.data.isPlaceholder ? "noindex,follow" : undefined} heroEyebrow="Theme review" heroTitle={entry.data.title} heroTagline={entry.data.description} heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/themes/">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Themes", href: "/themes/" }, { label: entry.data.themeName }]} />
  <EditorialByline date={entry.data.updated} label={entry.data.updatedLabel} />
  {entry.data.isPlaceholder ? <div class="editorial-notice" role="status">Editorial preview — this page is a transparent template for planned hands-on testing, not a completed recommendation.</div> : <div class="editorial-notice" role="status">Published {entry.data.researchMethod === "documented-research" ? "documentation research" : "hands-on review"} — scope and source links are shown below.</div>}
  <section class="verdict-panel" aria-labelledby="verdict-title">
    <p class="section-label">KreativWP verdict</p><h2 id="verdict-title">A qualified fit, not a universal winner.</h2>
    <div class="verdict-panel__grid"><div><strong>Consider it for</strong><p>{entry.data.bestFor}</p></div><div><strong>Pause if</strong><p>{entry.data.caveats}</p></div><div><strong>Review status</strong><p>{entry.data.researchMethod === "hands-on" ? "Hands-on review" : "Documented research"} · last checked {entry.data.updatedLabel}</p></div></div>
    <p class="verdict-panel__method"><a href="/methodology/">Read our editorial standards</a> before using this profile as a purchase decision.</p>
  </section>
  <section class="editorial-section" aria-labelledby="overview-title"><h2 id="overview-title">Profile at a glance</h2><dl class="fact-grid"><div><dt>Developer</dt><dd>{entry.data.developer}</dd></div><div><dt>Free version</dt><dd>{entry.data.freeVersion}</dd></div><div><dt>Price</dt><dd>{entry.data.price}</dd></div><div><dt>Best for</dt><dd>{entry.data.bestFor}</dd></div></dl></section>
  {entry.data.handsOnTest ? <section class="editorial-section hands-on-review" aria-labelledby="hands-on-title">
    <p class="section-label">Tested by KreativWP</p><h2 id="hands-on-title">A real page, in the free theme.</h2>
    <dl class="fact-grid"><div><dt>Test date</dt><dd>{entry.data.handsOnTest.date}</dd></div><div><dt>Theme version</dt><dd>{entry.data.handsOnTest.themeVersion}</dd></div><div><dt>WordPress</dt><dd>{entry.data.handsOnTest.wordpressVersion}</dd></div><div><dt>PHP</dt><dd>{entry.data.handsOnTest.phpVersion}</dd></div></dl>
    <p class="section-intro">{entry.data.handsOnTest.environment}</p>
    <div class="hands-on-review__checks">{entry.data.handsOnTest.checks.map((check) => <article><h3>{check.title}</h3><p>{check.detail}</p></article>)}</div>
    <div class="hands-on-review__gallery">{entry.data.handsOnTest.screenshots.map((shot) => <figure><a href={shot.src}><img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" /></a><figcaption>{shot.label} · open full screenshot</figcaption></figure>)}</div>
    <h3>What this test does not establish</h3><ul class="check-list">{entry.data.handsOnTest.limitations.map((limit) => <li>{limit}</li>)}</ul>
    <p class="centered-action"><a class="button-like" href={entry.data.handsOnTest.evidenceHref}>Read the recorded test results</a></p>
  </section> : null}
  <section class="editorial-section" aria-labelledby="testing-title"><h2 id="testing-title">What the documentation confirms</h2><ul class="check-list">{entry.data.highlights.map((item) => <li>{item}</li>)}</ul></section>
  <section class="editorial-section" aria-labelledby="scope-title"><h2 id="scope-title">Research scope</h2><p class="section-intro">{entry.data.researchScope}</p><p class="editorial-caveat"><strong>Important:</strong> {entry.data.caveats}</p><div class="source-links"><strong>Sources</strong><ul>{entry.data.sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul></div>{entry.data.officialUrl ? <p class="centered-action"><a class="button-like" href={entry.data.officialUrl} target="_blank" rel="noopener noreferrer">Visit the official site</a></p> : null}</section>
  {affiliate ? <><AffiliateDisclosure /><p class="centered-action"><a class="button-like" href={affiliate.href} target="_blank" rel="sponsored noopener noreferrer">{affiliate.label}</a></p></> : null}
</BaseLayout>
