---
import { getCollection } from "astro:content";
import LibraryFilter from "../../components/LibraryFilter.astro";
import ThemeCard from "../../components/ThemeCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const themes = (await getCollection("themeReviews")).sort((a, b) => a.data.themeName.localeCompare(b.data.themeName));
const themeFilters: Record<string, string[]> = {
  astra: ["lightweight", "block-editor", "page-builder", "free"], blocksy: ["lightweight", "block-editor", "ecommerce", "free"], divi: ["page-builder", "ecommerce"], frost: ["block-editor", "portfolio", "free"], generatepress: ["lightweight", "block-editor", "free"], "hello-elementor": ["lightweight", "page-builder", "free"], hestia: ["page-builder", "ecommerce", "free"], inspiro: ["portfolio", "page-builder", "free"], kadence: ["block-editor", "ecommerce", "free"], neve: ["lightweight", "block-editor", "page-builder", "ecommerce", "free"], oceanwp: ["ecommerce", "page-builder", "free"], ollie: ["block-editor", "free"], "spectra-one": ["block-editor", "portfolio", "free"], sydney: ["page-builder", "block-editor", "portfolio", "free"], "twenty-twenty-five": ["block-editor", "portfolio", "free"]
};
---
<BaseLayout title="WordPress Theme Reviews | KreativWP" description="Independent, clearly scoped WordPress theme reviews and selection guidance from KreativWP." canonicalPath="/themes/" heroEyebrow="WordPress research" heroTitle="Themes" heroTagline="Editorial theme reviews and practical selection guidance, built around real site requirements." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/themes/">
  <section class="theme-archive" data-library data-filter-section aria-labelledby="theme-reviews-title"><div class="section-heading"><div><p class="eyebrow">Editorial library</p><h2 id="theme-reviews-title">Explore WordPress themes</h2></div></div><p class="section-intro">Browse theme profiles by workflow and fit. Each published profile records whether it is documented research or a completed hands-on review.</p><LibraryFilter label="Filter WordPress themes" filters={[{ label: "All themes", value: "all" }, { label: "Lightweight", value: "lightweight" }, { label: "Block editor", value: "block-editor" }, { label: "Page builder", value: "page-builder" }, { label: "Portfolio", value: "portfolio" }, { label: "WooCommerce", value: "ecommerce" }, { label: "Free", value: "free" }]} /><div class="theme-catalogue__grid">{themes.map((theme, index) => <ThemeCard href={`/themes/${theme.id}/`} name={theme.data.themeName} developer={theme.data.developer} description={theme.data.description} freeVersion={theme.data.freeVersion} previewStyle={theme.data.previewStyle} thumbnail={theme.data.thumbnail} thumbnailAlt={theme.data.thumbnailAlt} filterValues={themeFilters[theme.id] || []} isPlaceholder={theme.data.isPlaceholder} featured={index === 0} />)}</div><p class="theme-catalogue__note">Theme screenshots come from the relevant WordPress.org listings and link to research profiles, not vendor pages.</p></section>
</BaseLayout>
