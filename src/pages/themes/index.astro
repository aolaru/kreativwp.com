---
import { getCollection } from "astro:content";
import ThemeCard from "../../components/ThemeCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const themes = (await getCollection("themeReviews")).sort((a, b) => a.data.themeName.localeCompare(b.data.themeName));
---
<BaseLayout title="WordPress Theme Reviews | KreativWP" description="Independent, clearly scoped WordPress theme reviews and selection guidance from KreativWP." canonicalPath="/themes/" heroEyebrow="WordPress research" heroTitle="Themes" heroTagline="Editorial theme reviews and practical selection guidance, built around real site requirements." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/themes/">
  <section class="theme-archive" aria-labelledby="theme-reviews-title"><div class="section-heading"><div><p class="eyebrow">Editorial library</p><h2 id="theme-reviews-title">Explore WordPress themes</h2></div></div><p class="section-intro">Browse theme profiles by workflow and fit. Each published profile records whether it is documented research or a completed hands-on review.</p><div class="theme-catalogue__filters"><span>All themes</span><span>Lightweight</span><span>Block editor</span><span>Portfolio</span><span>WooCommerce</span><span>Free</span></div><div class="theme-catalogue__grid">{themes.map((theme, index) => <ThemeCard href={`/themes/${theme.id}/`} name={theme.data.themeName} developer={theme.data.developer} description={theme.data.description} freeVersion={theme.data.freeVersion} previewStyle={theme.data.previewStyle} thumbnail={theme.data.thumbnail} thumbnailAlt={theme.data.thumbnailAlt} isPlaceholder={theme.data.isPlaceholder} featured={index === 0} />)}</div><p class="theme-catalogue__note">Theme screenshots come from the relevant WordPress.org listings and link to research profiles, not vendor pages.</p></section>
</BaseLayout>
