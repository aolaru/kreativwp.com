---
import { getCollection } from "astro:content";
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const tools = await getCollection("tools");
---
<BaseLayout title="Free WordPress Tools | KreativWP" description="Planned and practical free WordPress tools from KreativWP." canonicalPath="/tools/" heroEyebrow="Free WordPress resources" heroTitle="Tools" heroTagline="Useful WordPress decision-making tools, designed to be practical, clear, and lightweight." heroImageSrc="/kreativ-wp-logo-128.svg" heroImageAlt="KreativWP logo" currentPath="/tools/">
  <section class="editorial-section" aria-labelledby="tools-list-title"><div class="section-heading"><div><p class="eyebrow">Growing library</p><h2 id="tools-list-title">Free WordPress tools</h2></div></div><p class="section-intro">Working tools are labelled available; planned entries stay clearly marked until they are usable.</p><div class="content-grid content-grid--two">{tools.map((entry) => <ContentCard href={`/tools/${entry.id}/`} type={`${entry.data.availability} tool`} title={entry.data.title} description={entry.data.description} updatedLabel={entry.data.updatedLabel} isPlaceholder={entry.data.isPlaceholder} />)}</div></section>
</BaseLayout>
